# OpenClaw Gateway Token (32+ chars, generated)
OC_GATEWAY_TOKEN=replace-me-with-openssl-rand-hex-32

# Provider API keys
CEREBRAS_API_KEY=csk-your-key-here
GROQ_API_KEY=gsk-your-key-here
MINIMAX_API_KEY=sk-cp-your-key-here
NVIDIA_NIM_KEY=nvapi-your-key-here

# Orquestador
ORQUESTADOR_KEY=orquestador-internal

# DuckDNS
DUCKDNS_TOKEN=your-duckdns-token-here

# GitHub tokens (for agent runtimes)
CLAUDE_CODE_VPS_TOKEN=ghp_your-claude-token
MIMO_CODE_VPS_TOKEN=ghp_your-mimo-token
MAXBRY_BACKEND_TOKEN=ghp_your-backend-token

# Contabo API
CONTABO_CLIENT_ID=INT-12345
CONTABO_CLIENT_SECRET=your-secret

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=123456789

# Open WebUI
OPENAI_API_BASE=http://127.0.0.1:4000/v1
OPENAI_API_KEY=sk-your-openwebui-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key
