[Unit]
Description=OpenClaw LiteLLM Service (Cerebras Router)
After=network.target

[Service]
EnvironmentFile=/etc/litellm-nvidia.env
Type=simple
User=root
EnvironmentFile=/etc/litellm.env
ExecStart=/opt/nct/apps/litellm/venv/bin/litellm --config /opt/litellm/cerebras-config.yaml --port 4000 --host 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
