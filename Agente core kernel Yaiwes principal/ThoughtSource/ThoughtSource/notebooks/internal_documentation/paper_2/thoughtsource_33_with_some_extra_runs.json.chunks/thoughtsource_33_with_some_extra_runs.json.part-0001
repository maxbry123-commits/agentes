                    {
                        "id": "9a17b183-56ee-4cb1-865c-ee83d2b40d52_2",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's derive the differential diagnosis step by step: \n\nThe patient presents with weakness, fatigue, and hypoglycemia.\nThe doctor gave him vitamin tablets.\n\nThe most likely cause of hypoglycemia in this patient is an enzyme deficiency. Phosphoenol pyruvate carboxykinase and pyruvate carboxylase are enzymes involved in glycolysis. Glycogen phosphorylase is an enzyme involved in glycogenolysis. Glucose 6 phosphatase is an enzyme involved in gluconeogenesis.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Glucose 6 phosphatase",
                                "answer_from_choices": "",
                                "correct_answer": false
                            }
                        ],
