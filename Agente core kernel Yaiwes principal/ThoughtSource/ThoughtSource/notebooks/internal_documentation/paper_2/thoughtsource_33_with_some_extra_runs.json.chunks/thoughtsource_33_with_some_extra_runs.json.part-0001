                    {
                        "id": "a963bf66-e44e-445f-b3ba-26efcd836ad9_0",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step about how we might resuscitate a patient. \n\nThe first step would be to assess the patient's ABCs--airway, breathing, and circulation. \n\nIf the patient has a blocked airway, we would need to clear it. If the patient is not breathing, we would need to provide ventilation. \n\nAnd if the patient has no pulse, we would need to start CPR. \n\nOnce we have started CPR, we would need to monitor the patient's vital signs. The best guide for the management of resuscitation is the patient's blood pressure.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
