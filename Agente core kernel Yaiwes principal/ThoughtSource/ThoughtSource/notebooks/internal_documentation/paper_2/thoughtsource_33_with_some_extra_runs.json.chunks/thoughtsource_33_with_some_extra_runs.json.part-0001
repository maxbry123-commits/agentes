                                "answer_extraction_text": "",
                                "answer": "C) Daughter. A Punnett square can be used to calculate the chance of a trait being passed to someone's daughter.",
                                "answer_from_choices": "",
                                "correct_answer": true
                            }
                        ],
                        "author": "thoughtsource",
