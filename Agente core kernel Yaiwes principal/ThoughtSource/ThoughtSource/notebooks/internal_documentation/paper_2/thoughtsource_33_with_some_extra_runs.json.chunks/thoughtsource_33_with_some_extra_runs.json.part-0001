                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n\nStudent: What is hepatic first pass metabolism?\n\nProfessor: Hepatic first pass metabolism is the process by which the liver breaks down and metabolizes drugs before they reach the bloodstream.\n\nStudent: What routes of drug administration bypass hepatic first pass metabolism?\n\nProfessor: Intravenous, sublingual, and intradermal administration bypass hepatic first pass metabolism.",
                        "answers": [
