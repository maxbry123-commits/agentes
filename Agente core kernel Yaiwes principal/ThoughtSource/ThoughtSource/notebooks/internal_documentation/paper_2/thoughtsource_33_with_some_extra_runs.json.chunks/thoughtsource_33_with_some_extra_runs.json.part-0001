                    {
                        "id": "fd1abff0-73fe-49da-b311-3184d0c0e54d_0",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step about what we would want to do for a patient with an altered sensorium. \n\nThe first thing we would want to do is to make sure that the patient is stable. This means that we would want to check their vital signs and make sure that they are not in any immediate danger.\n\nOnce we have determined that the patient is stable, we would want to start running some tests. The first test that we would want to run is a complete blood count. This will give us information about the patient's overall health and will help us to rule out any potential causes of the altered sensorium.\n\nThe next test that we would want to run is a random blood sugar. This will help us to rule out any potential causes of the altered sensorium that are related to diabetes.\n\nThe next test that we would want to run is a lumbar puncture. This will help us to rule out any potential causes of the altered sensorium that are related to a brain injury.\n\nThe final test that we would want to run is a non-contrast CT head. This will help us to rule out any potential causes of the altered sensorium that are related to a head injury.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Non-contrast CT head",
                                "answer_from_choices": "",
                                "correct_answer": false
                            }
                        ],
                        "author": "lievin",
