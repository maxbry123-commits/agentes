                    },
                    {
                        "id": "7f8086d8-e91b-40fc-8d8c-55cc74f84d6c_3",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert. \n\nFirst, we need to understand what glycogen is. Glycogen is a polysaccharide of glucose that serves as a storage form of glucose in animals and fungi. In humans, glycogen is made primarily by the liver and the muscles.\n\nNow that we know what glycogen is, we can better understand the role of enzymes in glycogen storage. Enzymes are important for the storage of glycogen because they help to break down glycogen into glucose, which can then be used for energy.\n\nThe most likely enzyme deficiency in this case is phosphofructokinase I. Phosphofructokinase I is an enzyme that helps to break down glycogen into glucose.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
