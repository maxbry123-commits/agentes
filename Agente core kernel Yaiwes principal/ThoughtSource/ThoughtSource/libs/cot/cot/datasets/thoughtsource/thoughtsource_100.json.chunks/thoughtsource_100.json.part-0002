                    {
                        "id": "b4d9ead1-e3c7-446d-b49b-7e4dcbdada18_1",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-10",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step like a medical expert. \n\nThe Golgi tendon organ is a type of proprioceptor. Proprioceptors are sensory receptors that are found in the muscles, tendons, and joints. They provide information about the position and movement of the body. \n\nThe Golgi tendon organ is found in the tendons. It monitors the tension in the tendon. It is activated when the muscle contracts and the tendon is stretched. \n\nThe answer is C) Muscle tension.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Muscle tension",
