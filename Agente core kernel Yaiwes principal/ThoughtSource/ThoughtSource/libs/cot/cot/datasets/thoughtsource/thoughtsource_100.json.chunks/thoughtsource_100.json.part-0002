                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n\nStep 1: Read the question carefully and identify the key information.\n\n- The patient has complaints of lower limb weakness.\n- The examiner places one hand under the patient's heel.\n- The patient is asked to raise his other leg against downward resistance.\n- We need to identify the name of this test.\n\nStep 2: Eliminate the answer choices that are clearly incorrect.\n\n- Waddell's test is used to assess for non-organic or psychogenic pain, and is not related to lower limb weakness.\n- O'Donoghue test is used to assess for ligamentous injuries in the knee, and is not related to lower limb weakness.\n- McBride test is used to assess for instability in the metatarsophalangeal joint of the great toe, and is not related to lower limb weakness.\n\nStep 3: Consider the remaining answer choice and determine if it fits the description of the test.\n\n- The Hoover test involves placing one hand under the patient's heel and asking them to raise their affected leg while the examiner applies downward pressure on the opposite leg. The test is used to assess for malingering or non-organic weakness.\n\nStep 4: Confirm the answer.\n\n- The correct answer is A) Hoover test.\n\nTherefore, the name of the test described in the question is the Hoover test.",
                        "answers": [
                            {
                                "id": "83750970-0642-41bb-9165-279c78b74226",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": "A) Hoover test.",
                                "answer_from_choices": "A",
                                "correct_answer": true
                            }
                        ],
