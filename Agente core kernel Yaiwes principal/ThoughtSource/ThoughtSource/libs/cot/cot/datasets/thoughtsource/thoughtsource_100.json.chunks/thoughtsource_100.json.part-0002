                        "api_service": "",
                        "model": "{'name': 'text-davinci-002'}",
                        "comment": "",
                        "annotations": []
                    },
                    {
                        "id": "f3d65283-cf60-4fd3-a23a-804ca33bc8e9_1",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-10",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step like a medical expert. \n\nFirst, we need to calculate the net filtration pressure. \n\nNet filtration pressure = capillary hydrostatic pressure - (interstitial hydrostatic pressure + interstitial oncotic pressure)\n\nNet filtration pressure = 25 mm Hg - (2 mm Hg + 7 mm Hg)\n\nNet filtration pressure = 25 mm Hg - 9 mm Hg\n\nNet filtration pressure = 16 mm Hg\n\nNow, we need to calculate the capillary oncotic pressure. \n\nCapillary oncotic pressure = interstitial oncotic pressure + (net filtration pressure / 2)\n\nCapillary oncotic pressure = 7 mm Hg + (16 mm Hg / 2)\n\nCapillary oncotic pressure = 7 mm Hg + 8 mm Hg\n\nCapillary oncotic pressure = 15 mm Hg",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "27",
                                "answer_from_choices": "",
