                        "instruction": null,
                        "cot_trigger": "lievin-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's derive the differential diagnosis step by step: \n\n1. Catalase is an enzyme that breaks down hydrogen peroxide into water and oxygen. It is not an inflammatory mediator.\n2. Oxidase is an enzyme that catalyzes the oxidation of organic compounds. It is not an inflammatory mediator.\n3. Lysozyme is an enzyme that breaks down the peptidoglycan cell wall of bacteria. It is not an inflammatory mediator.\n4. IL6 is a cytokine that is involved in the inflammatory response. It is an inflammatory mediator.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "IL6",
                                "answer_from_choices": "",
                                "correct_answer": false
                            }
                        ],
