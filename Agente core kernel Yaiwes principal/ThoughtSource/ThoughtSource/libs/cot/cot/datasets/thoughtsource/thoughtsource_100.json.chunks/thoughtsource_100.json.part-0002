                    },
                    {
                        "id": "f3d65283-cf60-4fd3-a23a-804ca33bc8e9_3",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert: \n\n1) Net filtration pressure (NFP) = interstitial hydrostatic pressure (IHP) - interstitial oncotic pressure (IOP) - capillary hydrostatic pressure (CHP) + capillary oncotic pressure (COP)\n\n2) NFP = 2 - 7 - 25 + COP\n\n3) NFP = -30 + COP\n\n4) NFP = 3\n\n5) 3 = -30 + COP\n\n6) COP = 33\n\nThe answer is C) 23.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "23",
