                        "cot_trigger": "kojima-03",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "it is important to note that ligation of vessels is not typically the first line of treatment for epistaxis (nosebleeds). However, to answer the question, the vessel that is not ligated in case of epistaxis control is the internal carotid artery (option C). Ligation of this artery would be a very extreme measure and is not typically done for epistaxis control. The maxillary artery (option A), anterior ethmoidal artery (option B), and external carotid artery (option D) may be ligated in certain cases of severe or recurrent epistaxis.",
                        "answers": [
                            {
                                "id": "7b529e69-6575-48d2-a1b4-1555bbfad74e",
                                "answer_extraction": "kojima-A-D",
