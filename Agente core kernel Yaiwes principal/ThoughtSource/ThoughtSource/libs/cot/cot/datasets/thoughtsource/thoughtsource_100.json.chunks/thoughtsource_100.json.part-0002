                        "id": "51234bc7-9170-45cc-8494-837fe23af441_1",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-10",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step like a medical expert. \n\n1) You want to study the fat content in expressed breast milk of pre-term infants as compared to term infants. \n2) You want to know if there is a difference in fat content. \n3) You want to study a group of pre-term infants and a group of term infants. \n\nThe best study design for this scenario would be a prospective cohort study.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Prospective coho",
                                "answer_from_choices": "",
                                "correct_answer": false
