                                "id": "8bd14477-75e6-4987-afc8-dfab609ed334",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": "C) the heart, as it is the most muscular organ among the lungs, kidney, heart, and liver.",
                                "answer_from_choices": null,
                                "correct_answer": null
                            }
                        ],
                        "author": "thoughtsource",
                        "date": "2023/04/13 03:16:36",
