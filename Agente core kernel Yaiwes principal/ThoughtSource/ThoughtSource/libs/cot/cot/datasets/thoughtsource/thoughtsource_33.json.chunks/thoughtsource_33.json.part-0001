                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nQuestion: Which route of drug administration will NOT bypass hepatic first pass metabolism?\n\nAnswer: A) Oral",
