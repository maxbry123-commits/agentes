                                "id": "29895606-66bf-4124-afc9-209141de1994",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": "C) genetic contributors had long ears. The presence of specific genes for long ears in a rabbit's DNA is what determines whether or not they will have long ears.",
                                "answer_from_choices": "C",
                                "correct_answer": true
                            }
                        ],
