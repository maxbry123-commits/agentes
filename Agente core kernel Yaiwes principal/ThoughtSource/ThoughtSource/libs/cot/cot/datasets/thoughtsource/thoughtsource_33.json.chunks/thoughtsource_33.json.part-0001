                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nQuestion: What role does the Golgi tendon organ play during voluntary movements?\n\nAnswer: C) Change in length of muscle before and after the movement.",
