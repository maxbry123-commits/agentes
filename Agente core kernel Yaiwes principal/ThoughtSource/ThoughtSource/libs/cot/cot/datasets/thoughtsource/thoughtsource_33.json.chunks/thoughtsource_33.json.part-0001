                                "answer_extraction_text": "",
                                "answer": "D) Polypoidal choroidal vasculopathy, as it does not directly affect the optic nerve fibers and cause optic atrophy.",
                                "answer_from_choices": "D",
                                "correct_answer": true
                            }
