                    {
                        "id": "1ea93ed9-d8e7-4a8a-9e13-849f272f3606",
                        "fragments_version": "0.01",
                        "instruction": "zhou-01-ins",
                        "cot_trigger": null,
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nAnswer: B) Anterior cruciate ligament\n\nExplanation: The positive pivot shift test in the knee is indicative of an injury to the anterior cruciate ligament (ACL). This test involves the examiner applying a valgus force to the knee while the patient is in a supine position. If the ACL is injured, the tibia will subluxate anteriorly and then reduce as the examiner releases the valgus force. This is known as the \"pivot shift\" phenomenon.",
                        "answers": [
                            {
                                "id": "d0f786db-dc84-40f2-b835-22a1bb9c5a5a",
                                "answer_extraction": "kojima-A-D",
