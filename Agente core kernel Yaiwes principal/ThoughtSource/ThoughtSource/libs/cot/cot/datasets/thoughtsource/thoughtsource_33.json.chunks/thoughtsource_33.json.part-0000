                    {
                        "id": "f4dd80d5-d296-4cb8-b15a-e676cd873ca1",
                        "fragments_version": "0.01",
                        "instruction": "qa-12",
                        "cot_trigger": null,
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nThe most likely decreased value in this patient compared to a healthy adult is A) Systemic vascular resistance.\n\nSystemic vascular resistance (SVR) is the resistance to blood flow in the systemic circulation. It is determined by the amount of blood vessels, the size of the vessels, and the viscosity of the blood. When SVR is decreased, blood flow increases, leading to an increase in cardiac output.\n\nIn this patient, the physical examination findings of decreased radial pulses, delayed capillary refill, and multiple spider angiomata suggest that the patient has decreased SVR. Additionally, the patient's low blood pressure (85/59 mm Hg) is indicative of decreased SVR. The patient's history of drinking 10-12 beers daily and not seeing a physician in 15 years may also contribute to decreased SVR.\n\nThe other options (B) Fractional tissue oxygen extraction, (C) Carotid baroreceptor firing activity, (D) Pulmonary vascular resistance, and (E) Cardiac inotropy are not likely to be decreased in this patient compared to a healthy adult.",
                        "answers": [
                            {
                                "id": "47584b67-dd48-4eb4-ab4e-b14bebf6732c",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": " A) Systemic vascular resistance.",
                                "answer_from_choices": "A",
                                "correct_answer": false
                            }
                        ],
