                                "answer_extraction_text": "",
                                "answer": "\nD) Start him on both hydrocortisone and fludrocortisone therapy",
                                "answer_from_choices": "D",
                                "correct_answer": true
                            }
                        ],
                        "author": "thoughtsource",
