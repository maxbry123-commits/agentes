                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": " \n\nStep 1: The patient has a fever, cough, headache, and diarrhea. This suggests an infection. \n\nStep 2: The patient has been abroad and has interacted with local animals, visited spas, and eaten local foods. This suggests a zoonotic infection. \n\nStep 3: The patient has fine crackles on auscultation and patchy infiltrates in both lungs on chest radiograph. This suggests a respiratory infection. \n\nStep 4: The patient has mild hyponatremia and mild elevation of AST/ALT levels. This suggests a bacterial infection. \n\nStep 5: The organism that is most likely responsible for this patient's symptoms is associated with the characteristic of forming an endospore (A).",
                        "answers": [
                            {
                                "id": "30d56326-7459-49fa-a962-bab3ec8f5d05",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": " A.",
                                "answer_from_choices": "A",
                                "correct_answer": false
                            }
