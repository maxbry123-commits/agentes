                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nPlan:\n1. Assess the patient's vital signs and physical exam findings.\n2. Consider the patient's past medical history and current medications.\n3. Determine the most likely diagnosis based on the patient's presentation.\n4. Choose the most appropriate treatment plan based on the diagnosis.\n\nAnswer: D) Ceftriaxone, azithromycin, and admission to the intensive care unit.",
