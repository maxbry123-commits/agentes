                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nPlan:\n1. Understand the patient's condition and symptoms.\n2. Research the physiological responses to the patient's condition.\n3. Compare the physiological responses to a healthy adult.\n\nAnswer: A) Systemic vascular resistance",
