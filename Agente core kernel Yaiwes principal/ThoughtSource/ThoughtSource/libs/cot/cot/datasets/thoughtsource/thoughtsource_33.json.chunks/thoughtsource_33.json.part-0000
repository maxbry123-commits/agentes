                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nA) Angiography",
                        "answers": [
                            {
                                "id": "d4462a46-fd66-4c86-8383-f279684716fe",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": " A) Angiography. Angiography is a procedure used to diagnose and treat certain conditions of the heart and blood vessels. It involves the injection of a contrast dye into the blood vessels to make them visible on X-ray images. This procedure can help to diagnose and treat blockages in the coronary arteries, as well as other conditions such as aneurysms and arterial stenosis.",
