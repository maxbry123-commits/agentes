type Fts5PageWriter = TFts5PageWriter

type TFts5SegIter = struct {
	F__ccgo_align    [0]uint32
	FpSeg            uintptr
	Fflags           int32
	FiLeafPgno       int32
	FpLeaf           uintptr
	FpNextLeaf       uintptr
	F__ccgo_align5   [4]byte
