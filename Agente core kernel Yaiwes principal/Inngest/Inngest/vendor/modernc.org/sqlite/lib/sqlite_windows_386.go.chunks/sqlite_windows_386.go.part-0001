type Fts5DoclistIter = TFts5DoclistIter

type TFts5SegWriter = struct {
	F__ccgo_align         [0]uint32
	FiSegid               int32
	Fwriter               TFts5PageWriter
	FiPrevRowid           Ti64
	FbFirstRowidInDoclist Tu8
