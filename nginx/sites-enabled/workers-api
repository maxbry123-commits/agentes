server {
    listen 444 ssl;
    server_name _;
    ssl_certificate /etc/ssl/certs/openclaw.crt;
    ssl_certificate_key /etc/ssl/private/openclaw.key;
    location /api/v1/workers/ {
        proxy_pass http://127.0.0.1:8090/api/v1/workers/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/v1/tasks {
        proxy_pass http://127.0.0.1:8090/api/v1/tasks;
        proxy_set_header Host $host;
    }
    location /api/v1/workers {
        proxy_pass http://127.0.0.1:8090/api/v1/workers;
        proxy_set_header Host $host;
    }
}
