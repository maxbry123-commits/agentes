server {
    listen 445 ssl;
    server_name _;
    ssl_certificate /etc/ssl/certs/openclaw.crt;
    ssl_certificate_key /etc/ssl/private/openclaw.key;
    location /ping {
        return 200 "pong\n";
        add_header Content-Type text/plain;
    }
    location / {
        return 200 "ok\n";
    }
}
