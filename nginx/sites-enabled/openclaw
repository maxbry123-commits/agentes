server {
    listen 8443 ssl;
    server_name maxbry1.duckdns.org maxbry2.duckdns.org maxbry3.duckdns.org maxbry4.duckdns.org maxbry5.duckdns.org;
    ssl_certificate /etc/nginx/ssl/openclaw.crt;
    ssl_certificate_key /etc/nginx/ssl/openclaw.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    set $target 18789;
    if ($host = "maxbry1.duckdns.org") { set $target 18789; }
    if ($host = "maxbry2.duckdns.org") { set $target 18792; }
    if ($host = "maxbry3.duckdns.org") { set $target 18791; }
    if ($host = "maxbry4.duckdns.org") { set $target 18790; }
    if ($host = "maxbry5.duckdns.org") { set $target 18789; }

    proxy_connect_timeout 60s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_buffering off;
    proxy_request_buffering off;
    chunked_transfer_encoding on;

    location /v1/ {
        auth_basic "OpenClaw API";
        auth_basic_user_file /etc/nginx/auth/openclaw.htpasswd;
        proxy_pass http://127.0.0.1:18789/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mcp {
        proxy_pass http://127.0.0.1:18791/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /extras/ {
        proxy_pass http://127.0.0.1:18790/;
    }

    location /api/agents {
        auth_basic "OpenClaw API";
        auth_basic_user_file /etc/nginx/auth/openclaw.htpasswd;
        proxy_pass http://127.0.0.1:18789;
    }
    location /api/state {
        auth_basic "OpenClaw API";
        auth_basic_user_file /etc/nginx/auth/openclaw.htpasswd;
        proxy_pass http://127.0.0.1:18789;
    }

    location / {
        proxy_pass http://127.0.0.1:$target;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
