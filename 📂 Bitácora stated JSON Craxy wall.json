  "integration_1_20": {
    "contract": [
      {
        "step": 1,
        "name": "MOVE_PHYSICAL",
        "goal": "move original component trees to canonical YAIWES destinations and prove them from main",
        "forbidden": ["wire", "prune", "test", "rewrite_upstream"],
        "close_gate": "destination_readback_20_of_20"
      },
      {
        "step": 2,
        "name": "WIRE_PRUNE_1X1_NO_TESTS",
        "goal": "xray, classify A/B/C, add port/adapter/ficha/wiring/registry and minimal safe pruning",
        "forbidden": ["tests", "destructive_runtime_pruning"],
        "close_gate": "wire_prune_20_of_20"
      },
      {
        "step": 3,
        "name": "TEST_1X1",
        "goal": "validate contract, import/build, mount, behavior, health, failure path and evidence",
        "forbidden": ["claim_pass_without_evidence"],
        "close_gate": "test_pass_20_of_20"
      }
    ],
    "classification_options": {
      "A": {
        "name": "SUBAGENT_CHILD",
        "criteria": ["own_goal", "own_lifecycle", "tools", "memory_or_context", "autonomous_decisions"],
        "integration": "AgentPort -> policy/budget -> isolated runtime -> normalized result -> evidence"
      },
      "B": {
        "name": "WORKFLOW_DAG_POOL",
        "criteria": ["scheduler", "dag", "state_machine", "queue", "workers", "durable_execution", "multi_step", "loop"],
        "integration": "TaskClassifier -> WorkflowPort/ExecutionPort -> engine -> normalized result -> evidence"
      },
      "C": {
        "name": "MODULAR_CAPABILITY",
        "criteria": ["single_capability", "validation", "policy", "storage", "memory", "routing", "research_utility", "sandbox_helper"],
        "integration": "Adapter -> Ficha/Contract -> Registry -> UniversalPluginBus/Port -> evidence"
      }
    }
  },
