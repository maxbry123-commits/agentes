# ========== 应用配置 ==========
APP_NAME=H-Pentest
APP_VERSION=2.0.0
DEBUG=True

# ========== 数据库 ==========
DATABASE_URL=sqlite+aiosqlite:///./h_pentest.db

# ========== LLM配置 ==========
# OpenAI API配置（支持兼容接口：Kimi、通义千问等）
OPENAI_API_KEY=8a7f3a7e25a74ed3827610cca3ce4ec1.SIjLY7tBiulAvJ38
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# Worker层LLM（执行层）
WORKER_MODEL=GLM-4.6
WORKER_TEMPERATURE=0.7
WORKER_MAX_TOKENS=8192

# Meta层LLM（监督层）
META_MODEL=GLM-4.6
META_TEMPERATURE=0.3
META_MAX_TOKENS=8192

# Strategic层LLM（战略层）
STRATEGIC_MODEL=GLM-4.6
STRATEGIC_TEMPERATURE=0.5
STRATEGIC_MAX_TOKENS=8192

# ========== 任务配置 ==========
MAX_CONCURRENT_TASKS=3
DEFAULT_MAX_ROUNDS=30

# ========== 安全配置 ==========
# 如果需要JWT认证，取消注释
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30
