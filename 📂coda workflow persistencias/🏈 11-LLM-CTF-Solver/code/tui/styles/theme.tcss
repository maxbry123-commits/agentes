/* TUI 主题 — CTF Agent */

Screen {
    background: $surface;
}

Header {
    background: $panel;
    color: $text;
    text-style: bold;
    dock: top;
    height: 1;
}

Footer {
    background: $panel;
    color: $text-muted;
    dock: bottom;
    height: 1;
}

/* ── SolveScreen ────────────────────────────── */

#solve-body {
    layout: horizontal;
    height: 1fr;
}

#left-panel {
    width: 30%;
    layout: vertical;
    border: solid $panel;
}

#right-panel {
    width: 70%;
    layout: vertical;
    border: solid $panel;
}

/* PhaseGauge */
#phase-gauge {
    height: 6;
    border: solid $primary;
    padding: 0 1;
}

#phase-label {
    text-style: bold;
    text-align: center;
    height: 1;
}

#phase-bar {
    text-align: center;
    height: 1;
}

#phase-step {
    text-align: center;
    height: 1;
    color: $text-muted;
}

/* StepListView */
#step-list {
    height: 1fr;
    border: solid $surface-darken-1;
}

/* StepDetail */
#step-detail {
    height: 1fr;
    layout: vertical;
}

.section-toggle {
    height: 1;
    width: 100%;
    text-align: left;
    background: $panel;
    border: none;
    color: $text;
    text-style: bold;
}

.section-toggle:hover {
    background: $primary 20%;
}

.full-view-btn {
    height: 1;
    width: 16;
    background: $surface;
    border: none;
    color: $text-muted;
    text-style: italic;
}

.full-view-btn:hover {
    color: $primary;
}

#detail-think {
    height: auto;
    min-height: 1;
    max-height: 6;
    padding: 0 1;
    color: $text;
}

#detail-tools {
    height: auto;
    min-height: 1;
    max-height: 6;
    padding: 0 1;
    color: $text;
}

#detail-output {
    height: 1fr;
    min-height: 8;
}

#detail-analysis {
    height: auto;
    min-height: 1;
    max-height: 8;
    padding: 0 1;
    color: $text;
}

/* HelpModal */
#help-modal {
    width: 56;
    height: auto;
    min-height: 12;
    max-height: 28;
    background: $panel;
    border: thick $secondary;
    padding: 1 2;
}

#help-content {
    height: 1fr;
    padding: 1;
    color: $text;
}

/* ThinkDetailModal */
#think-detail-modal {
    width: 70;
    height: auto;
    min-height: 10;
    max-height: 30;
    background: $panel;
    border: thick $accent;
    padding: 1 2;
}

#think-full-content {
    height: 1fr;
    min-height: 6;
    max-height: 24;
    overflow-y: auto;
    padding: 1;
    color: $text;
}

/* AttackSurfaceTree */
#attack-surface-tree {
    height: 20;
    border: solid $panel;
}

/* AttackPathWidget */
#attack-path {
    height: 1fr;
    min-height: 8;
    border: solid $panel;
}

#attack-path-title {
    height: 1;
    text-style: bold;
    padding: 0 1;
    background: $panel;
    color: $secondary;
}

#attack-path-log {
    height: 1fr;
    min-height: 6;
}

/* ── SessionListScreen ──────────────────────── */

#session-container {
    height: 1fr;
    padding: 1 2;
}

#session-title {
    height: 1;
    text-style: bold;
    padding: 1 0;
}

#session-list {
    height: 1fr;
    border: solid $panel;
}

#session-buttons {
    height: 3;
    align: center middle;
}

/* ── NewSessionScreen ───────────────────────── */

#new-session-container {
    height: 1fr;
    padding: 1 2;
}

#ns-title {
    height: 1;
    text-style: bold;
    padding: 1 0;
}

#ns-mode {
    height: auto;
    margin: 1 0;
}

#ns-problem {
    height: 1fr;
    min-height: 10;
    border: solid $panel;
    margin: 1 0;
}

#ns-buttons {
    height: 3;
    align: center middle;
}

/* ── KnowledgeBaseScreen ────────────────────── */

#kb-body {
    layout: horizontal;
    height: 1fr;
}

#kb-left {
    width: 40%;
    layout: vertical;
    border: solid $panel;
}

#kb-right {
    width: 60%;
    layout: vertical;
    border: solid $panel;
    padding: 1 2;
}

#kb-search-bar {
    height: 3;
    align: center middle;
    padding: 0 1;
}

#kb-search-input {
    width: 1fr;
}

#kb-list {
    height: 1fr;
    border: solid $surface-darken-1;
}

#kb-actions {
    height: 3;
    align: center middle;
}

#kb-detail {
    height: 1fr;
    overflow-y: auto;
    padding: 1;
    color: $text;
}

/* AddKnowledgeModal */
#add-kb-modal {
    width: 60;
    height: auto;
    min-height: 14;
    max-height: 32;
    background: $panel;
    border: thick $secondary;
    padding: 1 2;
}

#akb-title {
    height: 1;
    text-style: bold;
    text-align: center;
    padding: 1 0;
}

#akb-type {
    height: auto;
    margin: 1 0;
}

#akb-buttons {
    align: center middle;
    height: 3;
}

/* ── Modals ─────────────────────────────────── */

#confirm-modal, #choice-modal, #input-modal {
    width: 60;
    height: auto;
    min-height: 10;
    max-height: 30;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
    align: center middle;
}

#confirm-prompt, #choice-prompt, #input-prompt {
    padding: 1 0;
    text-align: center;
    text-style: bold;
}

#confirm-buttons, #input-buttons {
    align: center middle;
    height: 3;
}

#input-field {
    width: 50;
    margin: 1 0;
}
