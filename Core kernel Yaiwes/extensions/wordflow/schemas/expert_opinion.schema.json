{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wordflow.expert_opinion.v1",
  "title": "ExpertOpinion",
  "type": "object",
  "required": ["expert_id", "role", "vote", "confidence"],
  "properties": {
    "expert_id": { "type": "string" },
    "role": { "type": "string" },
    "vote": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "ABSTAIN", "REVISE"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "meta": { "type": "object" }
  }
}
