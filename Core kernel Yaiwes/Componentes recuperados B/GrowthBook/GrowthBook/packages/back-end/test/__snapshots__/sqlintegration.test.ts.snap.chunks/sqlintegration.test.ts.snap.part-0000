exports[`full fact metric experiment query - bigquery generated fact metric SQL is correct for type_mean__cap_percentile__agg_sum__col_special_distinctUsers__inline_none__filter_mobile__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none 1`] = `"-- Fact Table: Orders Fact Table WITH __rawExperiment AS (*), __experimentExposures AS ( -- Viewed Experiment SELECT e.user_id as user_id, cast(e.variation_id as string) as variation, CAST(e.timestamp as DATETIME) as timestamp FROM __rawExperiment e WHERE e.experiment_id = '' AND e.timestamp >= '2023-01-01 00:00:00' AND e.timestamp <= '2023-01-31 00:00:00' ), __experimentUnits AS ( -- One row per user SELECT e.user_id AS user_id, ( CASE WHEN count(distinct e.variation) > 1 THEN '__multiple__' ELSE max(e.variation) END ) AS variation, MIN(e.timestamp) AS first_exposure_timestamp FROM __experimentExposures e GROUP BY e.user_id ), __distinctUsers AS ( SELECT user_id, variation, first_exposure_timestamp AS timestamp, date_trunc(first_exposure_timestamp, DAY) AS first_exposure_date, first_exposure_timestamp AS m0_preexposure_end, DATETIME_SUB(first_exposure_timestamp, INTERVAL 96 HOUR) AS m0_preexposure_start FROM __experimentUnits ), __factTable as ( -- Fact Table (Orders Fact Table) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Generated Metric: mean (sum $$distinctUsers) CASE WHEN ((app = 'mobile')) THEN 1 ELSE NULL END as m0_value FROM (*) m WHERE m.timestamp >= '2022-12-28 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' AND (app = 'mobile') ), __userMetricJoin as ( SELECT d.variation AS variation, d.timestamp AS timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= d.timestamp AND m.timestamp <= '2023-01-31 00:00:00' AND DATETIME_ADD(m.timestamp, INTERVAL 48 HOUR) >= '2023-01-31 00:00:00' THEN m.m0_value ELSE NULL END ) as m0_value, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_value ELSE NULL END ) AS m0_covariate_value FROM 