 0) ) AS m0_main_pre_denominator_post_sum_product, SUM( COALESCE(m.m0_covariate_value, 0) * COALESCE(m.m0_covariate_denominator, 0) ) AS m0_main_pre_denominator_pre_sum_product, SUM( COALESCE(m.m0_denominator, 0) * COALESCE(m.m0_covariate_denominator, 0) ) AS m0_denominator_post_denominator_pre_sum_product FROM __userMetricAgg m GROUP BY m.variation"`;

