 THEN m.m0_value ELSE NULL END ) AS m0_covariate_value FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, COUNT(umj.m0_value) AS m0_value, COUNT(umj.m0_covariate_value) AS m0_covariate_value FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __capValue AS ( SELECT APPROX_QUANTILES(m0_value, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_value_cap FROM __userMetricAgg ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_mean__cap_percentile__agg_count_distinct__col_special_count__inline_type__filter_mobile__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, MAX(COALESCE(cap.m0_value_cap, 0)) as m0_main_cap_value, SUM(LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap)) AS m0_main_sum, SUM( POWER( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap), 2 ) ) AS m0_main_sum_squares, SUM(COALESCE(m.m0_covariate_value, 0)) AS m0_covariate_sum_uncapped, SUM(POWER(COALESCE(m.m0_covariate_value, 0), 2)) AS m0_covariate_sum_squares_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_covariate_value, 0) ) AS m0_main_covariate_sum_product_uncapped, SUM( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) ) AS m0_covariate_sum, SUM( POWER( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ), 2 ) ) AS m0_covariate_sum_squares, SUM( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap) * LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) ) AS m0_main_covariate_sum_product FROM __userMetricAgg m CROSS JOIN __capValue cap GROUP BY m.variation"`;

