 LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) ) AS m0_main_covariate_sum_product, SUM( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap) * LEAST( COALESCE(m.m0_covariate_denominator, 0), cap.m0_denominator_cap ) ) AS m0_main_post_denominator_pre_sum_product, SUM( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) * LEAST( COALESCE(m.m0_denominator, 0), cap.m0_denominator_cap ) ) AS m0_main_pre_denominator_post_sum_product, SUM( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) * LEAST( COALESCE(m.m0_covariate_denominator, 0), cap.m0_denominator_cap ) ) AS m0_main_pre_denominator_pre_sum_product, SUM( LEAST( COALESCE(m.m0_denominator, 0), cap.m0_denominator_cap ) * LEAST( COALESCE(m.m0_covariate_denominator, 0), cap.m0_denominator_cap ) ) AS m0_denominator_post_denominator_pre_sum_product FROM __userMetricAgg m CROSS JOIN __capValue cap GROUP BY m.variation"`;

