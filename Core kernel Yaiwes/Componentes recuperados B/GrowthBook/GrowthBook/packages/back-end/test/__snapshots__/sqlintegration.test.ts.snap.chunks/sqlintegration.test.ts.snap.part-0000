 GROUP BY umj.variation, umj.user_id ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_mean__cap_absolute__agg_max__col_special_count__inline_type__filter_mobile__window_lookback__regadj_none__aggfilter_none__aggfiltercol_none' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, SUM(LEAST(COALESCE(m.m0_value, 0), 1000)) AS m0_main_sum, SUM(POWER(LEAST(COALESCE(m.m0_value, 0), 1000), 2)) AS m0_main_sum_squares FROM __userMetricAgg m GROUP BY m.variation"`;

