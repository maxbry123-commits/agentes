iation AS variation, COUNT(*) AS users, cast( 'type_mean__cap_absolute__agg_max__col_special_distinctUsers__inline_none__filter_mobile__window_none__regadj_none__aggfilter_none__aggfiltercol_none' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, SUM(LEAST(COALESCE(m.m0_value, 0), 1000)) AS m0_main_sum, SUM(POWER(LEAST(COALESCE(m.m0_value, 0), 1000), 2)) AS m0_main_sum_squares FROM __userMetricAgg m GROUP BY m.variation"`;

