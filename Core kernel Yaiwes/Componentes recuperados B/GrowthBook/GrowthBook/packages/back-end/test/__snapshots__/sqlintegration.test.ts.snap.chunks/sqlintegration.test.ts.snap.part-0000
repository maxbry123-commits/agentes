exports[`full fact metric experiment query - bigquery generated fact metric SQL is correct for type_ratio__cap_percentile__agg_sum__col_special_distinctDates__inline_none__filter_none__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none__denom_max_special_distinctUsers 1`] = `"-- Fact Table: Orders Fact Table WITH __rawExperiment AS (*), __experimentExposures AS ( -- Viewed Experiment SELECT e.user_id as user_id, cast(e.variation_id as string) as variation, CAST(e.timestamp as DATETIME) as timestamp FROM __rawExperiment e WHERE e.experiment_id = '' AND e.timestamp >= '2023-01-01 00:00:00' AND e.timestamp <= '2023-01-31 00:00:00' ), __experimentUnits AS ( -- One row per user SELECT e.user_id AS user_id, ( CASE WHEN count(distinct e.variation) > 1 THEN '__multiple__' ELSE max(e.variation) END ) AS variation, MIN(e.timestamp) AS first_exposure_timestamp FROM __experimentExposures e GROUP BY e.user_id ), __distinctUsers AS ( SELECT user_id, variation, first_exposure_timestamp AS timestamp, date_trunc(first_exposure_timestamp, DAY) AS first_exposure_date, first_exposure_timestamp AS m0_preexposure_end, DATETIME_SUB(first_exposure_timestamp, INTERVAL 96 HOUR) AS m0_preexposure_start FROM __experimentUnits ), __factTable as ( -- Fact Table (Orders Fact Table) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Generated Metric: ratio (sum $$distinctDates) date_trunc(m.timestamp, DAY) as m0_value, -- Generated Metric: ratio (sum $$distinctDates) (denominator) 1 as m0_denominator FROM (*) m WHERE m.timestamp >= '2022-12-28 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' ), __userMetricJoin as ( SELECT d.variation AS variation, d.timestamp AS timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= d.timestamp AND m.timestamp <= '2023-01-31 00:00:00' AND DATETIME_ADD(m.timestamp, INTERVAL 48 HOUR) >= '2023-01-31 00:00:00' THEN m.m0_value ELSE NULL END ) as m0_value, ( CASE WHEN m.timestamp >= d.timestamp AND m.timestamp <= '2023-01-31 00:00:00' AND DATETIME_ADD(m.timestamp, INTERVAL 48 HOUR) >= '2023-01-31 00:00:00' THEN m.m0_denominator ELSE NULL END ) as m0_denominator, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_value ELSE NULL END ) AS m0_covariate_value, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_denominator ELSE NULL END ) AS m0_covariate_denominator FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, COUNT(DISTINCT umj.m0_value) AS m0_value, COALESCE(MAX(umj.m0_denominator), 0) AS m0_denominator, COUNT(DISTINCT umj.m0_covariate_value) AS m0_covariate_value, COALESCE(MAX(umj.m0_covariate_denominator), 0) AS m0_covariate_denominator FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __capValue AS ( SELECT APPROX_QUANTILES(m0_value, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_value_cap, APPROX_QUANTILES(m0_denominator, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_denominator_cap FROM __userMetricAgg ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_ratio__cap_percentile__agg_sum__col_special_distinctDates__inline_none__filter_none__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none__denom_max_special_distinctUsers' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, MAX(COALESCE(cap.m0_value_cap, 0)) as m0_main_cap_value, SUM(LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap)) AS m0_main_sum, SUM( POWER( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap), 2 ) ) AS m0_main_sum_squares, SUM(COALESCE(m.m0_denominator, 0)) AS m0_denominator_sum_uncapped, SUM(POWER(COALESCE(m.m0_denominator, 0), 2)) AS m0_denominator_sum_squares_uncapped, SUM( COALESCE(m.m0