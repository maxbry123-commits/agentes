e__window_conversion__regadj_4d__aggfilter_none__aggfiltercol_none__denom_facttable_events' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, MAX(COALESCE(cap.m0_value_cap, 0)) as m0_main_cap_value, SUM(LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap)) AS m0_main_sum, SUM( POWER( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap), 2 ) ) AS m0_main_sum_squares, SUM(COALESCE(m1.m0_denominator, 0)) AS m0_denominator_sum_uncapped, SUM(POWER(COALESCE(m1.m0_denominator, 0), 2)) AS m0_denominator_sum_squares_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m1.m0_denominator, 0) ) AS m0_main_denominator_sum_product_uncapped, MAX(COALESCE(cap1.m0_denominator_cap, 0)) as m0_denominator_cap_value, SUM( LEAST( COALESCE(m1.m0_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_denominator_sum, SUM( POWER( LEAST( COALESCE(m1.m0_denominator, 0), cap1.m0_denominator_cap ), 2 ) ) AS m0_denominator_sum_squares, SUM(COALESCE(m.m0_covariate_value, 0)) AS m0_covariate_sum_uncapped, SUM(POWER(COALESCE(m.m0_covariate_value, 0), 2)) AS m0_covariate_sum_squares_uncapped, SUM(COALESCE(m1.m0_covariate_denominator, 0)) AS m0_denominator_pre_sum_uncapped, SUM( POWER(COALESCE(m1.m0_covariate_denominator, 0), 2) ) AS m0_denominator_pre_sum_squares_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_covariate_value, 0) ) AS m0_main_covariate_sum_product_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m1.m0_covariate_denominator, 0) ) AS m0_main_post_denominator_pre_sum_product_uncapped, SUM( COALESCE(m.m0_covariate_value, 0) * COALESCE(m1.m0_denominator, 0) ) AS m0_main_pre_denominator_post_sum_product_uncapped, SUM( COALESCE(m.m0_covariate_value, 0) * COALESCE(m1.m0_covariate_denominator, 0) ) AS m0_main_pre_denominator_pre_sum_product_uncapped, SUM( COALESCE(m1.m0_denominator, 0) * COALESCE(m1.m0_covariate_denominator, 0) ) AS m0_denominator_post_denominator_pre_sum_product_uncapped, SUM( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) ) AS m0_covariate_sum, SUM( POWER( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ), 2 ) ) AS m0_covariate_sum_squares, SUM( LEAST( COALESCE(m1.m0_covariate_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_denominator_pre_sum, SUM( POWER( LEAST( COALESCE(m1.m0_covariate_denominator, 0), cap1.m0_denominator_cap ), 2 ) ) AS m0_denominator_pre_sum_squares, SUM( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap) * LEAST( COALESCE(m1.m0_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_main_denominator_sum_product, SUM( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap) * LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) ) AS m0_main_covariate_sum_product, SUM( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap) * LEAST( COALESCE(m1.m0_covariate_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_main_post_denominator_pre_sum_product, SUM( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) * LEAST( COALESCE(m1.m0_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_main_pre_denominator_post_sum_product, SUM( LEAST( COALESCE(m.m0_covariate_value, 0), cap.m0_value_cap ) * LEAST( COALESCE(m1.m0_covariate_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_main_pre_denominator_pre_sum_product, SUM( LEAST( COALESCE(m1.m0_denominator, 0), cap1.m0_denominator_cap ) * LEAST( COALESCE(m1.m0_covariate_denominator, 0), cap1.m0_denominator_cap ) ) AS m0_denominator_post_denominator_pre_sum_product FROM __userMetricAgg m CROSS JOIN __capValue cap LEFT JOIN __userMetricAgg1 m1 ON (m1.user_id = m.user_id) CROSS JOIN __capValue1 cap1 GROUP BY m.variation"`;

