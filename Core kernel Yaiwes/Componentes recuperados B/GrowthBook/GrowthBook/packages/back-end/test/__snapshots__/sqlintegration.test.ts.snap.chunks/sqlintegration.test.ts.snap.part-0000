 as m0_denominator, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_value ELSE NULL END ) AS m0_covariate_value, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_denominator ELSE NULL END ) AS m0_covariate_denominator FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, COALESCE(MAX(umj.m0_value), 0) AS m0_value, COUNT(DISTINCT umj.m0_denominator) AS m0_denominator, COALESCE(MAX(umj.m0_covariate_value), 0) AS m0_covariate_value, COUNT(DISTINCT umj.m0_covariate_denominator) AS m0_covariate_denominator FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __capValue AS ( SELECT APPROX_QUANTILES(m0_value, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_value_cap, APPROX_QUANTILES(m0_denominator, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_denominator_cap FROM __userMetricAgg ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_ratio__cap_percentile__agg_count_distinct__col_special_distinctUsers__inline_none__filter_none__window_none__regadj_4d__aggfilter_none__aggfiltercol_none__denom_max_special_distinctDates' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, MAX(COALESCE(cap.m0_value_cap, 0)) as m0_main_cap_value, SUM(LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap)) AS m0_main_sum, SUM( POWER( LEAST(COALESCE(m.m0_value, 0), cap.m0_value_cap), 2 ) ) AS m0_main_sum_squares, SUM(COALESCE(m.m0_denominator, 0)) AS m0_denominator_sum_uncapped, SUM(POWER(COALESCE(m.m0_denominator, 0), 2)) AS m0_denominator_sum_squares_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_denominator, 0) ) AS m0_main_denominator_sum_product_uncapped, MAX(COALESCE(cap.m0_