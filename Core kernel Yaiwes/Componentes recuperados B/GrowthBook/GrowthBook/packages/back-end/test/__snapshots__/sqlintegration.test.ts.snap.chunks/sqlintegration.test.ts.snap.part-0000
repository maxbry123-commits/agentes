ser SELECT umj.variation, umj.user_id, COUNT(DISTINCT umj.m0_value) AS m0_value, COUNT(umj.m0_denominator) AS m0_denominator FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_ratio__cap_none__agg_sum__col_special_distinctDates__inline_none__filter_none__window_none__regadj_none__aggfilter_none__aggfiltercol_none__denom_count_distinct_special_count' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares, SUM(COALESCE(m.m0_denominator, 0)) AS m0_denominator_sum, SUM(POWER(COALESCE(m.m0_denominator, 0), 2)) AS m0_denominator_sum_squares, SUM( COALESCE(m.m0_denominator, 0) * COALESCE(m.m0_value, 0) ) AS m0_main_denominator_sum_product FROM __userMetricAgg m GROUP BY m.variation"`;

