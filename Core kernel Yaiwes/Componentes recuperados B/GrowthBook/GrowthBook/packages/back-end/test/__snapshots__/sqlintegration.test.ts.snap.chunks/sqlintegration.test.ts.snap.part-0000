NULL END ) AS m0_covariate_value FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, COUNT(DISTINCT umj.m0_value) AS m0_value, COUNT(DISTINCT umj.m0_covariate_value) AS m0_covariate_value FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __capValue AS ( SELECT APPROX_QUANTILES(m0_value, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_value_cap FROM __userMetricAgg ), __factTable1 as ( -- Fact Table (Events Fact Table) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Generated Metric: ratio (count distinct $$distinctDates) (denominator) 1 as m0_denominator FROM (*) m WHERE m.timestamp >= '2022-12-28 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' ), __userMetricJoin1 as ( SELECT d.variation AS variation, d.timestamp AS timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= d.timestamp AND m.timestamp <= '2023-01-31 00:00:00' AND DATETIME_ADD(m.timestamp, INTERVAL 48 HOUR) >= '2023-01-31 00:00:00' THEN m.m0_denominator ELSE NULL END ) as m0_denominator, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_denominator ELSE NULL END ) AS m0_covariate_denominator FROM __distinctUsers d LEFT JOIN __factTable1 m ON (m.user_id = d.user_id) ), __userMetricAgg1 as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, COUNT(umj.m0_denominator) AS m0_denominator, COUNT(umj.m0_covariate_denominator) AS m0_covariate_denominator FROM __userMetricJoin1 umj GROUP BY umj.variation, umj.user_id ), __capValue1 AS ( SELECT APPROX_QUANTILES(m0_denominator, 10000 IGNORE NULLS) [OFFSET(CAST(9500 AS INT64))] AS m0_denominator_cap FROM __userMetricAgg1 ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_ratio__cap_percentile__agg_count_distinct__col_special_disti