S m0_covariate_value FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, SUM(COALESCE((umj.m0_value), 0)) AS m0_value, SUM(COALESCE((umj.m0_covariate_value), 0)) AS m0_covariate_value FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_proportion__cap_none__agg_none__col_special_distinctUsers__inline_none__filter_mobile__window_conversion__regadj_4d__aggfilter____3__aggfiltercol_qty' as string ) as m0_id, SUM( COALESCE( ( CASE WHEN m.m0_value >= 3 THEN 1 ELSE NULL END ), 0 ) ) AS m0_main_sum, SUM( POWER( COALESCE( ( CASE WHEN m.m0_value >= 3 THEN 1 ELSE NULL END ), 0 ), 2 ) ) AS m0_main_sum_squares, SUM( COALESCE( ( CASE WHEN m.m0_covariate_value >= 3 THEN 1 ELSE NULL END ), 0 ) ) AS m0_covariate_sum, SUM( POWER( COALESCE( ( CASE WHEN m.m0_covariate_value >= 3 THEN 1 ELSE NULL END ), 0 ), 2 ) ) AS m0_covariate_sum_squares, SUM( COALESCE( ( CASE WHEN m.m0_value >= 3 THEN 1 ELSE NULL END ), 0 ) * COALESCE( ( CASE WHEN m.m0_covariate_value >= 3 THEN 1 ELSE NULL END ), 0 ) ) AS m0_main_covariate_sum_product FROM __userMetricAgg m GROUP BY m.variation"`;

