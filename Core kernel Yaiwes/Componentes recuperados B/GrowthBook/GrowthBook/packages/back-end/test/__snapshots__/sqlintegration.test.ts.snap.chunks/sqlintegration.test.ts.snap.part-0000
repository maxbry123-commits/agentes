e FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, HLL_COUNT.EXTRACT(HLL_COUNT.INIT(umj.m0_value)) AS m0_value, HLL_COUNT.EXTRACT(HLL_COUNT.INIT(umj.m0_covariate_value)) AS m0_covariate_value FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_mean__cap_absolute__agg_count_distinct__col_amount__inline_type__filter_none__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, SUM(LEAST(COALESCE(m.m0_value, 0), 1000)) AS m0_main_sum, SUM(POWER(LEAST(COALESCE(m.m0_value, 0), 1000), 2)) AS m0_main_sum_squares, SUM(COALESCE(m.m0_covariate_value, 0)) AS m0_covariate_sum_uncapped, SUM(POWER(COALESCE(m.m0_covariate_value, 0), 2)) AS m0_covariate_sum_squares_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_covariate_value, 0) ) AS m0_main_covariate_sum_product_uncapped, SUM(LEAST(COALESCE(m.m0_covariate_value, 0), 1000)) AS m0_covariate_sum, SUM( POWER(LEAST(COALESCE(m.m0_covariate_value, 0), 1000), 2) ) AS m0_covariate_sum_squares, SUM( LEAST(COALESCE(m.m0_value, 0), 1000) * LEAST(COALESCE(m.m0_covariate_value, 0), 1000) ) AS m0_main_covariate_sum_product FROM __userMetricAgg m GROUP BY m.variation"`;

