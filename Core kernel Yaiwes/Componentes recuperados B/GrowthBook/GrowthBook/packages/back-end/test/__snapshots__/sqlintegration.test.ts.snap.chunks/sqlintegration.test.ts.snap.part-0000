exports[`full fact metric experiment query - bigquery generated fact metric SQL is correct for type_mean__cap_absolute__agg_max__col_amount__inline_type__filter_none__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none 1`] = `"-- Fact Table: Orders Fact Table WITH __rawExperiment AS (*), __experimentExposures AS ( -- Viewed Experiment SELECT e.user_id as user_id, cast(e.variation_id as string) as variation, CAST(e.timestamp as DATETIME) as timestamp FROM __rawExperiment e WHERE e.experiment_id = '' AND e.timestamp >= '2023-01-01 00:00:00' AND e.timestamp <= '2023-01-31 00:00:00' ), __experimentUnits AS ( -- One row per user SELECT e.user_id AS user_id, ( CASE WHEN count(distinct e.variation) > 1 THEN '__multiple__' ELSE max(e.variation) END ) AS variation, MIN(e.timestamp) AS first_exposure_timestamp FROM __experimentExposures e GROUP BY e.user_id ), __distinctUsers AS ( SELECT user_id, variation, first_exposure_timestamp AS timestamp, date_trunc(first_exposure_timestamp, DAY) AS first_exposure_date, first_exposure_timestamp AS m0_preexposure_end, DATETIME_SUB(first_exposure_timestamp, INTERVAL 96 HOUR) AS m0_preexposure_start FROM __experimentUnits ), __factTable as ( -- Fact Table (Orders Fact Table) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Generated Metric: mean (max amount) CASE WHEN ((type = 'discount')) THEN m.amount ELSE NULL END as m0_value FROM (*) m WHERE m.timestamp >= '2022-12-28 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' AND (type = 'discount') ), __userMetricJoin as ( SELECT d.variation AS variation, d.timestamp AS timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= d.timestamp AND m.timestamp <= '2023-01-31 00:00:00' AND DATETIME_ADD(m.timestamp, INTERVAL 48 HOUR) >= '2023-01-31 00:00:00' THEN m.m0_value ELSE NULL END ) as m0_value, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_value ELSE NULL END ) AS m0_covariate_value FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, COALESCE(MAX(umj.m0_value), 0) AS m0_value, COALESCE(MAX(umj.m0_covariate_value), 0) AS m0_covariate_value FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_mean__cap_absolute__agg_max__col_amount__inline_type__filter_none__window_lookback__regadj_4d__aggfilter_none__aggfiltercol_none' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum_uncapped, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares_uncapped, SUM(LEAST(COALESCE(m.m0_value, 0), 1000)) AS m0_main_sum, SUM(POWER(LEAST(COALESCE(m.m0_value, 0), 1000), 2)) AS m0_main_sum_squares, SUM(COALESCE(m.m0_covariate_value, 0)) AS m0_covariate_sum_uncapped, SUM(POWER(COALESCE(m.m0_covariate_value, 0), 2)) AS m0_covariate_sum_squares_uncapped, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_covariate_value, 0) ) AS m0_main_covariate_sum_product_uncapped, SUM(LEAST(COALESCE(m.m0_covariate_value, 0), 1000)) AS m0_covariate_sum, SUM( POWER(LEAST(COALESCE(m.m0_covariate_value, 0), 1000), 2) ) AS m0_covariate_sum_squares, SUM( LEAST(COALESCE(m.m0_value, 0), 1000) * LEAST(COALESCE(m.m0_covariate_value, 0), 1000) ) AS m0_main_covariate_sum_product FROM __userMetricAgg m GROUP BY m.variation"`;

