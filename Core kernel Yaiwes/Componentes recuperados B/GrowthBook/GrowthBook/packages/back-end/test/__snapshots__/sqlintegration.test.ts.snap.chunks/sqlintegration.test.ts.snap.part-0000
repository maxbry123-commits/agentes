xposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_value ELSE NULL END ) AS m0_covariate_value, ( CASE WHEN m.timestamp >= d.m0_preexposure_start AND m.timestamp < d.m0_preexposure_end THEN m.m0_denominator ELSE NULL END ) AS m0_covariate_denominator FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, HLL_COUNT.EXTRACT(HLL_COUNT.INIT(umj.m0_value)) AS m0_value, HLL_COUNT.EXTRACT(HLL_COUNT.INIT(umj.m0_denominator)) AS m0_denominator, HLL_COUNT.EXTRACT(HLL_COUNT.INIT(umj.m0_covariate_value)) AS m0_covariate_value, HLL_COUNT.EXTRACT(HLL_COUNT.INIT(umj.m0_covariate_denominator)) AS m0_covariate_denominator FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast( 'type_ratio__cap_none__agg_count_distinct__col_amount__inline_none__filter_none__window_none__regadj_4d__aggfilter_none__aggfiltercol_none__denom_count_distinct_amount' as string ) as m0_id, SUM(COALESCE(m.m0_value, 0)) AS m0_main_sum, SUM(POWER(COALESCE(m.m0_value, 0), 2)) AS m0_main_sum_squares, SUM(COALESCE(m.m0_denominator, 0)) AS m0_denominator_sum, SUM(POWER(COALESCE(m.m0_denominator, 0), 2)) AS m0_denominator_sum_squares, SUM(COALESCE(m.m0_covariate_value, 0)) AS m0_covariate_sum, SUM(POWER(COALESCE(m.m0_covariate_value, 0), 2)) AS m0_covariate_sum_squares, SUM(COALESCE(m.m0_covariate_denominator, 0)) AS m0_denominator_pre_sum, SUM(POWER(COALESCE(m.m0_covariate_denominator, 0), 2)) AS m0_denominator_pre_sum_squares, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_denominator, 0) ) AS m0_main_denominator_sum_product, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_covariate_value, 0) ) AS m0_main_covariate_sum_product, SUM( COALESCE(m.m0_value, 0) * COALESCE(m.m0_covariate_denominator, 0) ) AS m0_main_post_denominator_pre_sum_product, SUM( COALESCE(m.m0_c