{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "maxbry://extension/manifest/v1",
  "title": "Wordflow Kernel Extension Manifest",
  "type": "object",
  "required": ["name", "version", "abi_version", "capabilities"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "abi_version": { "type": "string", "enum": ["1.0.0"] },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^C[0-9]{2}$" }
    },
    "mount_modes": {
      "type": "array",
      "items": { "type": "string", "enum": ["wordflow", "extension", "dual"] }
    },
    "entry": { "type": "string" }
  }
}
