  },

  "failover": {"sustituible_por": [], "compensacion": "ESCALATE_TO_DIRECTOR_ON_FAIL"},

  "seguridad": {
    "sandbox": "process",
    "permisos": ["network:github.com", "fs:agents/OpenClaw", "exec:git", "exec:pnpm", "exec:node", "exec:openclaw"],
    "limites": {"timeout_ms": 1800000, "deadline_ms": 2100000, "max_memoria_mb": 2048}
  },

  "salud": {"metodo": "exec", "heartbeat_interval_s": 60},

  "firma": {"gpg_key_id": "PENDIENTE", "revocation_ref": "contracts/revocation_list.json"},

