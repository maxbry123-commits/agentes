    "idempotente": true,
    "entry_point": "control-layer/subsheriffs/openclaw_acquire/acquire.py"
  },

  "perfiles": {
    "n0": {"habilitada": true, "iteraciones": 1},
    "n1": {"habilitada": true, "iteraciones": 1},
    "n2": {"habilitada": true, "iteraciones": 1},
    "n3": {"habilitada": true, "iteraciones": 1},
    "n4": {"habilitada": true, "iteraciones": 1},
    "n5": {"habilitada": true, "iteraciones": 1}
  },

  "repeticion": {"max": 2, "condicion": "si_falla_verificacion", "backoff": "1000*2^n+rand(0,1000)"},
  "repite_en": [],

  "activacion": {
    "eventos": ["wordflow.sheriff.request:openclaw_acquire"],
    "wake_words": [],
    "condicion": "manual_approval_gate OR council_scheduled_infra_task"
  },

  "presupuesto": {
    "n0": {"max_ms": 1800000, "max_costo_usd": 0},
    "n1": {"max_ms": 1800000, "max_costo_usd": 0},
    "n2": {"max_ms": 1800000, "max_costo_usd": 0},
    "n3": {"max_ms": 1800000, "max_costo_usd": 0},
    "n4": {"max_ms": 1800000, "max_costo_usd": 0},
    "n5": {"max_ms": 1800000, "max_costo_usd": 0}
  },

  "telemetria": {
