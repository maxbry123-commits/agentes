                                "answer_extraction_text": "",
                                "answer": "D) Sentinel node - right lumbar trunk - cisterna chyli - thoracic duct - right subclavian vein - systemic circulation.",
                                "answer_from_choices": "D",
                                "correct_answer": false
                            }
