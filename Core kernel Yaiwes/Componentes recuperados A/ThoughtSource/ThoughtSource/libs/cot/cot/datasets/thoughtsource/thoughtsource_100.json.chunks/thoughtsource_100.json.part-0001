                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step about what's happening in the Bezold-Jarisch reflex.\n\nThe Bezold-Jarisch reflex is initiated by stimulation of baroreceptors in the aortic arch and carotid sinus. This stimulation leads to a decrease in heart rate and blood pressure.\n\nThe baroreceptors send signals to the brainstem, which then sends signals to the heart to slow down the heart rate. The brainstem also sends signals to the blood vessels to constrict, which increases blood pressure.\n\nThe Bezold-Jarisch reflex is mediated by the autonomic nervous system, which is controlled by the brainstem. The autonomic nervous system uses different neurotransmitters to send signals to the heart and blood vessels.\n\nThe neurotransmitter that is used to send signals to the heart is acetylcholine. The neurotransmitter that is used to send signals to the blood vessels is norepinephrine.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Histamine",
                                "answer_from_choices": "",
                                "correct_answer": false
                            }
                        ],
