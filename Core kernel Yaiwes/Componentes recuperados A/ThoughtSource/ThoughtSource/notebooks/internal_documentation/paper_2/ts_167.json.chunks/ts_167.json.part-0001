                    {
                        "id": "bc46556f-fa41-449d-860c-a722e9efb018",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n\nThe pivot shift test is used to assess the stability of the knee joint, particularly the anterior cruciate ligament (ACL). During the test, the examiner applies a valgus force to the knee while it is flexed, and then rotates the tibia externally. If there is an ACL injury, the tibia will subluxate anteriorly and then reduce back into place, causing a positive pivot shift test.\n\nTherefore, the correct answer is B) Anterior cruciate ligament.",
                        "answers": [
                            {
                                "id": "006f079e-74f4-44f4-9e5b-75c2a986c482",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": "B) Anterior cruciate ligament.",
                                "correct_answer": true
                            }
                        ],
                        "author": "thoughtsource",
                        "date": "2023/03/11 01:43:51",
                        "api_service": "openai_chat",
                        "model": "{'name': 'gpt-3.5-turbo', 'temperature': 0, 'max_tokens': 512}",
                        "comment": "",
