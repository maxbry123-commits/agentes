                    {
                        "id": "8a34b58c-c256-45a4-a5a9-93a82f37aae5",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": " A 10-year-old boy has an IOL placed in his eye. 10 years later, he is now 20 years old. The IOL should be removed if the posterior capsule has ossified, if presbyopia has set in, or if the IOL needs to be changed for any other reason.",
