                        ],
                        "author": "thoughtsource",
                        "date": "2023/04/07 22:36:57",
                        "api_service": "cohere",
                        "model": "{'name': 'command-xlarge-nightly', 'temperature': 0, 'max_tokens': 512}",
                        "comment": "",
