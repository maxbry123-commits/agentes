                    {
                        "id": "57a0a6a1-8c3a-4df6-81c2-b4bd0447f257",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "zhou-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n\nThe patient's presentation and laboratory results suggest a diagnosis of Cushing's syndrome, which is characterized by excess cortisol production. The high serum cortisol levels and lack of suppression with a high dose dexamethasone suppression test suggest that the source of excess cortisol is likely an adrenal tumor or hyperplasia, rather than a pituitary adenoma.\n\nA) MRI of the adrenal glands: This is a reasonable option to evaluate for an adrenal tumor or hyperplasia, but it is not the best next step in management.\n\nB) MRI of the chest: This is not indicated based on the patient's presentation and laboratory results.\n\nC) MRI of the pituitary gland: This is not the best next step in management, as the patient's presentation and laboratory results suggest that the source of excess cortisol is likely adrenal in origin.\n\nD) Low dose dexamethasone suppression test: This is not necessary, as the patient has already failed a high dose dexamethasone suppression test.\n\nE) Inferior petrosal sinus sampling: This is the best next step in management, as it can help differentiate between a pituitary adenoma and an adrenal tumor or hyperplasia as the source of excess cortisol. In this procedure, a catheter is inserted into the inferior petrosal sinus, which drains blood from the pituitary gland, and samples are taken to measure ACTH levels. If the ACTH levels are higher in the petrosal sinus than in a peripheral vein, this suggests a pituitary adenoma as the source of excess ACTH and cortisol. If the ACTH levels are similar in the petrosal sinus and peripheral vein, this suggests an adrenal tumor or hyperplasia as the source of excess cortisol.",
                        "answers": [
                            {
                                "id": "e5a72726-dccb-4738-892b-d24029a4e0f7",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": "E) Inferior petrosal sinus sampling.",
                                "correct_answer": false
                            }
                        ],
