                        "cot_trigger": null,
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "The patient is presenting with sinus tachycardia and an enlarged cardiac silhouette on chest radiograph, which suggests the possibility of cardiac tamponade. The fact that the radial pulse cannot be palpated during inspiration is known as pulsus paradoxus, which is a classic sign of cardiac tamponade. Therefore, the next step in management of this patient should be to perform a pericardiocentesis (option B) to relieve the pressure on the heart. This procedure involves inserting a needle through the chest wall and into the pericardial sac to drain the excess fluid or blood that is causing the tamponade. Options A, C, D, and E are not appropriate in this situation as they do not address the underlying problem of cardiac tamponade.",
                        "answers": [
                            {
                                "id": "1a9c1816-7eec-4c05-b53d-a8f21f5d3692",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": "B) Pericardiocentesis.",
                                "correct_answer": true
                            }
                        ],
