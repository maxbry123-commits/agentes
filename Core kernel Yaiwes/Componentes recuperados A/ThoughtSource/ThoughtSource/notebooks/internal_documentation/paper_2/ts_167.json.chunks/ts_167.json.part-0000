                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "Plan:\n1. Identify the definition of being dead.\n2. Determine the characteristics of being dead.\n3. Match the characteristics with the given options.\n\nAnswer: \nC) breathing. When someone is dead, they stop breathing and their heart stops beating.",
                        "answers": [
