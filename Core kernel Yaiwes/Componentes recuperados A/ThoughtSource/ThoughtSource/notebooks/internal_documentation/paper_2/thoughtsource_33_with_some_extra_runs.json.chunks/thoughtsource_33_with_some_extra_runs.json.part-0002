                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n\nThe Sun, Moon, and asteroids all have gravitational influence, but the Moon has the most influence because it is closest to Earth. The Moon's gravity pulls on the Earth's oceans, causing the water to rise and fall.",
