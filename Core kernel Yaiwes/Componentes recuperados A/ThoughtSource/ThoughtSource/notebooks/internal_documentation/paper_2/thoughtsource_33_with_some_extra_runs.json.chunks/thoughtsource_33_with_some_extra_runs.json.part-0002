                                "answer_extraction_text": "",
                                "answer": "A) Cooling temperatures, as this is the process that leads to the formation of igneous rocks in the rock cycle.",
                                "answer_from_choices": "",
                                "correct_answer": true
                            }
                        ],
                        "author": "thoughtsource",
