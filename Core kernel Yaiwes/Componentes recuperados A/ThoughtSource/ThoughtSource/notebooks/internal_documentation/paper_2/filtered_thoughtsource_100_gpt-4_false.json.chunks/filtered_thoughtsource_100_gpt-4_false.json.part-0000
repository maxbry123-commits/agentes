                        "cot_trigger": null,
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "The correct answer is E) Oligoclonal bands on cerebrospinal fluid analysis.\nThis patient has Guillain-Barr\u00e9 syndrome. The most common presenting symptom is progressive weakness and paresthesias in the legs that ascends to the arms. Weakness can progress to respiratory failure. The pathophysiology is thought to be an autoimmune response directed against the myelin sheath of peripheral nerves.\nCSF analysis reveals elevated protein with normal cell count and oligoclonal bands. Electrophysiologic studies show demyelination.\nCSF eosinophilia is seen in parasitic CNS infection, CNS lymphoma, and tuberculosis.\nXanthochromia is seen in hemorrhagic stroke.\nIncreased CSF protein with normal cell count is seen in viral CNS infection, bacterial CNS infection, and multiple sclerosis.",
                        "answers": [
                            {
                                "id": "d2f81a8a-a7c1-4294-87a8-042423a741b3",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": " E) Oligoclonal bands on cerebrospinal fluid analysis.",
                                "correct_answer": false
                            }
                        ],
