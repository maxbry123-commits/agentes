                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert. \n\nThe patient has a history of myocardial infarction (heart attack) and is complaining of chest pain. This suggests that the pain may be related to the heart. \n\nThe first laboratory test that would be most diagnostic would be an electrocardiogram (ECG). This would show if there has been any changes in the patient's heart since the last ECG. \n\nIf the ECG is normal, the next laboratory test that would be most diagnostic would be a troponin T test. This would show if there is any damage to the heart muscle. \n\nIf the troponin T test is normal, the next laboratory test that would be most diagnostic would be a creatinine kinase (CK-MB) test. This would show if there is any damage to the heart muscle. \n\nIf the CK-MB test is normal, the next laboratory test that would be most diagnostic would be a lactate dehydrogenase (LDH) test. This would show if there is any damage to the heart muscle. \n\nIf the LDH test is normal, the next laboratory test that would be most diagnostic would be an alkaline phosphatase (ALP) test. This would show if there is any damage to the heart muscle.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Troponin T",
                                "correct_answer": false
                            }
                        ],
                        "author": "lievin",
