                    {
                        "id": "bea6f69c-59b1-4a01-9c11-80a89d376f43",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": null,
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "The correct answer is A) Poststreptococcal glomerulonephritis (PSGN).\nPoststreptococcal glomerulonephritis (PSGN) is a type of glomerulonephritis that is caused by an immune response to Group A Streptococcus (GAS) infection. The immune response is characterized by the production of antibodies against GAS antigens, which bind to and damage the glomerular basement membrane. This damage leads to the accumulation of immune complexes and inflammatory cells in the glomerulus, causing inflammation and damage to the glomerular structure.\n\nMembrano proliferative glomerulonephritis (MPGN) is a type of glomerulonephritis that is characterized by the accumulation of immune complexes in the glomerulus, leading to inflammation and damage to the glomerular structure.\n\nRapidly progressive glomerulonephritis (RPGN) is a type of glomerulonephritis that is characterized by a rapid progression of renal dysfunction, often leading to end-stage renal disease within weeks or months.\n\nMinimal change disease is a type of glomerulonephritis that is characterized by the presence of small, non-specific changes in the glomerulus, including increased mesangial matrix and/or mesangial cells.\n\nMembranous glomerulonephritis (MGN) is a type of glomerulonephritis that is characterized by the presence of immune complexes in the glomerulus, leading to inflammation and damage to the glomerular structure.\n\nA) Poststreptococcal glomerulonephritis (PSGN)",
                        "answers": [
                            {
                                "id": "0d5d1e22-f78a-4d67-8023-e88bf71a63fa",
                                "answer_extraction": "kojima-A-E",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": " A) Poststreptococcal glomerulonephritis (PSGN).",
                                "correct_answer": false
                            }
                        ],
