                        "instruction": null,
                        "cot_trigger": "lievin-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's derive the differential diagnosis step by step:  \n\nThe patient has lower limb weakness. This could be caused by a number of things, including:\n\n-Neurological conditions (e.g. stroke, ALS)\n-Muscular conditions (e.g. myopathy, muscular dystrophy)\n-Joint conditions (e.g. arthritis)\n\nThe examiner places one hand under the patient's heel and asks the patient to raise his other leg against downward resistance. This is known as the Hoover test.\n\nThe Hoover test is used to assess for weakness of the iliopsoas muscle. This muscle is important for hip flexion. weakness of the iliopsoas muscle can be caused by a number of things, including:\n\n-Neurological conditions (e.g. stroke, ALS)\n-Muscular conditions (e.g. myopathy, muscular dystrophy)\n-Joint conditions (e.g. arthritis)",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Hoover test",
                                "correct_answer": true
                            }
                        ],
                        "author": "lievin",
