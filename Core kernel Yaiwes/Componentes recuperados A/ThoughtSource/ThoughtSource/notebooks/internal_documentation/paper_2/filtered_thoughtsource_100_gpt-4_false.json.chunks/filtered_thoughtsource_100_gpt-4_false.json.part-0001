                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's derive the differential diagnosis step by step: \n\n1) Spontaneous CSF rhinorrhea: This is a leak of CSF from the dura into the nose or ear in the absence of trauma. The most common cause is a congenital CSF leak. The most common site is the cribriform plate.\n\n2) Traumatic CSF rhinorrhea: This is a leak of CSF from the dura into the nose or ear in the presence of trauma. The most common cause is a skull fracture.\n\n3) Both: A CSF leak can be caused by either a congenital defect or a skull fracture.\n\n4) None: A CSF leak can be caused by either a congenital defect or a skull fracture, but not by a target sign.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
