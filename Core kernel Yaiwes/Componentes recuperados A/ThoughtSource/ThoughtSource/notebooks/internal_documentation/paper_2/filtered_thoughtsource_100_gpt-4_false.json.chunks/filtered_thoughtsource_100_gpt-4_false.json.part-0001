                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nStep 1: Microbe enters the cell.\nStep 2: Microbe is engulfed by the cell.\nStep 3: Microbe is killed inside the cell.\nStep 4: Microbe is digested inside the cell.\nStep 5: Microbe is presented to the immune system.\nStep 5 is the correct answer.\nD) IL6",
