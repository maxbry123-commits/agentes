                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n1. There has been a gradual increase in number of non-communicable disease cases as compared to previous years. This trend is called:\n2. A) Seasonal means that it happens every year.\n3. B) Cyclical means that it happens every few years.\n4. C) Periodical means that it happens every few months.\n5. D) Secular means that it happens over a long period of time.",
                        "answers": [
                            {
                                "id": "a8ad1f49-edcd-4454-876e-068ac59e2797",
                                "answer_extraction": "kojima-A-D",
