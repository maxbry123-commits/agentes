                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert: \n\n1) Catalase is an enzyme that helps to break down hydrogen peroxide into water and oxygen. \n2) Oxidase is an enzyme that helps to oxidize a substrate. \n3) Lysozyme is an enzyme that helps to break down peptidoglycans. \n4) IL6 is a cytokine that helps to regulate the immune response. \n\nFrom the given options, it is most likely that IL6 is the inflammatory mediator that is involved in intracellular killing of microbes.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
