                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert. \n\nRoth spots are retinal hemorrhages with a white center. They are seen in infective endocarditis, leukemia, and other diseases.\n\nOsler's nodes are tender, erythematous nodules on the hands or feet. They are seen in infective endocarditis and other diseases.\n\nAschoff nodules are histologically characterized by foci of myocardial necrosis surrounded by areas of myocarditis. They are seen in infective endocarditis and other diseases.\n\nA positive blood culture is when bacteria are growing in the blood. This is seen in infective endocarditis.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
