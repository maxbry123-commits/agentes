                    {
                        "id": "8e6b14ff-6ff8-4d60-9226-7f37f3c802d8",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "IOLs are not designed to last forever. IOLs are designed to last for 10 years. IOLs should be changed after 10 years. So, the answer is D.",
                        "answers": [
