                        "cot_trigger": "lievin-10",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step like a medical expert. \n\nThe IOL should be removed if the posterior capsule ossifies. If the IOL is never removed, then the patient will experience presbyopia, or age-related farsightedness, and will need to have the IOL changed after 10 years.",
                        "answers": [
                            {
                                "id": "0",
