                    {
                        "id": "b4d9ead1-e3c7-446d-b49b-7e4dcbdada18_0",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step about what would happen if each of these were true. \n\nA) Static muscle length: The Golgi tendon organ would detect when the muscle is at rest and not contracting. \n\nB) Dynamic muscle length: The Golgi tendon organ would detect when the muscle is contracting and changing length. \n\nC) Muscle tension: The Golgi tendon organ would detect when the muscle is contracting and generating force. \n\nD) Muscle action: The Golgi tendon organ would detect when the muscle is contracting and generating force. \n\nThe correct answer is C) Muscle tension.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
