                    {
                        "id": "98608eff-a01f-4e7e-b97d-e76d46678e63",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nThe interstitial hydrostatic pressure is 2 mm Hg, interstitial oncotic pressure is 7 mm Hg and capillary hydrostatic pressure is 25 mm Hg. What should be the capillary oncotic pressure to allow a net filtration pressure of 3 mm Hg?\nThe capillary oncotic pressure should be 3 mm Hg.\n\nSince the filtration pressure is 3 mm Hg, the capillary hydrostatic pressure should be 25 mm Hg - 3 mm Hg = 22 mm Hg.\nThe capillary oncotic pressure should be 3 mm Hg - 22 mm Hg = -22 mm Hg.\nThe capillary oncotic pressure should be -22 mm Hg / 7 mm Hg = -3 mm Hg.\nThe capillary oncotic pressure should be -3 mm Hg / 2 mm Hg = -1.5 mm Hg.\nThe capillary oncotic pressure should be -1.5 mm Hg / 0.5 mm Hg = -3 mm Hg.\nThe capillary oncotic pressure should be 3 mm Hg.",
                        "answers": [
                            {
                                "id": "eaf5a0d7-68e2-4ee0-8fa6-ebdb0d0254f4",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
