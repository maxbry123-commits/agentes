                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\nA) DNA repair: This is a process that occurs in the other direction, from 3' to 5'.\nB) DNA replication: This occurs in the 5' to 3' direction.\nC) RNA editing: This occurs in the other direction, from 3' to 5'.\nD) Transcription: This occurs in the 5' to 3' direction.",
