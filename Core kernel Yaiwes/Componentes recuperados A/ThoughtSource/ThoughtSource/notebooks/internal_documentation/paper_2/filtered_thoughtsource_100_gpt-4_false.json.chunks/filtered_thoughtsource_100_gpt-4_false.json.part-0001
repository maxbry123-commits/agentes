                    {
                        "id": "d58a8e4e-0f5e-42bb-8b24-75a882eacfa2_2",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's derive the differential diagnosis step by step: \n\n1. IOL placed in the young male.\n2. After 10 year what should be done..?\n\nThe answer to this question depends on the clinical situation of the patient 10 years after the IOL was placed. If the patient is experiencing posterior capsular opacification (PCO), then the IOL should be removed. If the patient is not experiencing PCO, then the IOL should not be removed.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "IOL should be removed in case of Posterior Capsule ossification",
