                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert. \n\nIOL should be removed in case of Posterior Capsule ossification: \nThis is not always the case. Sometimes, the IOL can be left in place and a YAG laser can be used to clear the ossification. \n\nNever be removed: \nThis is not correct. IOLs may need to be removed or replaced due to various reasons, such as dislocation, decentration, or capsular fibrosis. \n\nRemove when presbyopia sets in: \nThis is not necessarily the case. IOLs are often designed to correct for presbyopia, so removing them when presbyopia sets in would defeat the purpose. \n\nShould be changed after 10 year: \nThis is not always the case. IOLs can last for many years, but they may need to be changed due to various reasons, such as dislocation, decentration, or capsular fibrosis.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Should be changed after 10 year",
                                "correct_answer": false
                            }
                        ],
