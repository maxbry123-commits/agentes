                    {
                        "id": "59020852-ed4d-4f44-932b-98da5cd0f47b_0",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's think step by step about what would be the most important thing to know in each stage of a clinical trial. \n\nThe first stage is phase 1, and the most important thing to know in this stage is safety. If a drug is not safe, then there is no point in continuing to test it. \n\nThe second stage is phase 2, and the most important thing to know in this stage is efficacy. This is because, even if a drug is safe, it might not actually work to treat the condition it is supposed to. \n\nThe third stage is phase 3, and the most important thing to know in this stage is dose. This is because, even if a drug is safe and effective, the wrong dose might cause more harm than good. \n\nThe fourth stage is phase 4, and the most important thing to know in this stage is pharmacokinetics. This is because, even if a drug is safe, effective, and the right dose, it might not be absorbed properly by the body or it might be metabolized too quickly to be effective.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Safety",
                                "correct_answer": false
                            }
                        ],
