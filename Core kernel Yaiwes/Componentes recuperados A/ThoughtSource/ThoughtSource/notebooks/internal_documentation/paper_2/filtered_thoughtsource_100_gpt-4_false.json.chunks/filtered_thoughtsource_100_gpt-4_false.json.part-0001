                        "instruction": null,
                        "cot_trigger": "kojima-01",
                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n\nThe first thing you should do is C) Check for response and call for help. This is because you need to assess the patient's level of consciousness and call for additional medical assistance if needed. If the patient is unresponsive, you may need to start CPR, but it is important to call for help first to ensure that you have the necessary resources and support. Once you have called for help, you can then proceed with checking for a pulse and starting chest compressions and rescue breaths if necessary.",
                        "answers": [
                            {
                                "id": "f101f91c-c2bb-433c-9713-7744d15b6325",
