                        "api_service": "",
                        "model": "{'name': 'text-davinci-002'}",
                        "comment": "",
                        "annotations": []
                    },
                    {
                        "id": "b4d9ead1-e3c7-446d-b49b-7e4dcbdada18_3",
                        "fragments_version": "0.01",
                        "instruction": null,
                        "cot_trigger": "lievin-03",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's differentiate using step by step reasoning like a medical expert. \n\nGolgi tendon organs are located in tendons, which are the connective tissues that attach muscles to bones. These organs detect changes in muscle tension. When the muscle contracts, the tendon is pulled, which activates the Golgi tendon organ. This, in turn, sends a signal to the spinal cord that inhibits the muscle contraction.\n\nIn other words, the Golgi tendon organ detects muscle tension.",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "",
                                "answer_extraction_text": "",
                                "answer": "Muscle tension",
                                "correct_answer": true
                            }
                        ],
                        "author": "lievin",
                        "date": null,
                        "api_service": "",
                        "model": "{'name': 'text-davinci-002'}",
                        "comment": "",
