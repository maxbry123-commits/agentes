                        "instruction": null,
                        "cot_trigger": "lievin-01",
                        "cot_trigger_template": "",
                        "prompt_text": "",
                        "cot": "Let's derive the differential diagnosis step by step:\n\n1) Neonatal mortality rate = (Number of neonatal deaths / Number of live births) x 1,000\n\n2) Neonatal mortality rate = (450 / 12,450) x 1,000\n\n3) Neonatal mortality rate = (3.6) x 1,000\n\n4) Neonatal mortality rate = 3,600",
                        "answers": [
                            {
                                "id": "0",
                                "answer_extraction": "kojima-A-D",
