                        "cot_trigger_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}",
                        "prompt_text": "",
                        "cot": "\n- 4 cm of water before inspiration means that the intrapleural pressure is -4/4 = -1.\n- 9 cm of water after inspiration means that the intrapleural pressure is -9/9 = -1.\nThe difference between the two measurements is -1 - (-1) = 2.\nThe pulmonary compliance is 2/2 = 1.\nThe correct answer is 1.",
                        "answers": [
                            {
                                "id": "10e27dfa-212d-4a78-8d86-6b63b3e24fac",
                                "answer_extraction": "kojima-A-D",
                                "answer_extraction_template": "{instruction}\n\n{question}\n{answer_choices}\n\n{cot_trigger}{cot}\n{answer_extraction}",
                                "answer_extraction_text": "",
                                "answer": " 1.",
                                "correct_answer": false
                            }
                        ],
                        "author": "thoughtsource",
