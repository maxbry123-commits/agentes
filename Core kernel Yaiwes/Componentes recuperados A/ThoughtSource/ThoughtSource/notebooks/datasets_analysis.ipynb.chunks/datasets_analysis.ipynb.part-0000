{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": 33,
   "metadata": {},
   "outputs": [],
   "source": [
    "from cot import Collection, stats\n",
    "from pprint import pprint"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Datasets analysis"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Create collection loading all datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# load all available datasets\n",
    "collection = Collection(\"all\", verbose=False, load_pregenerated_cots=\"all\")\n",
    "# drop med_qa_open since it is almost identical to med_qa\n",
    "collection.unload_datasets([\"med_qa_open\"])\n",
    "# load our own created CoTs\n",
    "collection_thoughtsource_33 = Collection.load_thoughtsource_33()\n",
    "# merge them to one file\n",
    "collection = collection.merge(collection_thoughtsource_33)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "metadata": {},
