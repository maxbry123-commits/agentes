# MareNostrum 5 (BSC Barcelona, H100 64GB) — cluster-scoped exports only.
# NO secret values (privileged values live in $DC_AGENT_SECRET_ENV).
# Specs: https://www.bsc.es/marenostrum/marenostrum/technical-information
# TBD: verify paths on first cluster access.
export DCFT=$HOME/OpenThoughts-Agent
export HF_HOME=$HOME/hf_cache
export HF_CACHE_DIR=$HOME/hf_cache
export HF_HUB_CACHE=$HOME/hf_cache
export DC_AGENT_SECRET_ENV=$HOME/secrets.env
export WANDB_PROJECT=OpenThoughts-Agent
export CHECKPOINTS_DIR=$HOME/checkpoints
export MODELS_DIR=$HOME/models
export DATASETS_DIR=$HOME/datasets
export TOKENIZED_DATASETS_DIR=$HOME/tokenized_datasets
export PYTHONPATH="$DCFT:${PYTHONPATH:-}"
