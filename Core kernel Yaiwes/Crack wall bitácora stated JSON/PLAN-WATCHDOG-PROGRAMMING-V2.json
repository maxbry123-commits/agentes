    "claimed_node_action": "SKIP",
    "lock_flow": ["READ_FRESH", "CLAIM_EXISTING_FREE_NODE", "CHECKPOINT_BEFORE", "EXECUTE_CURRENT_STEP_ONLY", "CHECKPOINT_AFTER", "WRITE_EVIDENCE", "PASS_OR_GAP", "RELEASE"]
