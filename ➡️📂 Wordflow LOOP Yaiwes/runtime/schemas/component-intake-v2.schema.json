{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaiwes.component_intake/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "operation", "source", "destination"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "operation": {"enum": ["DOWNLOAD_EXTRACT", "EXTRACT"]},
    "source": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "pattern": "^➡️📂 Wordflow LOOP Yaiwes/"},
    "expected_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "DOWNLOAD_EXTRACT"}}},
      "then": {"required": ["expected_ref"]}
    },
    {
      "if": {"properties": {"operation": {"const": "EXTRACT"}}},
      "then": {"required": ["expected_sha256"]}
    }
  ]
}
