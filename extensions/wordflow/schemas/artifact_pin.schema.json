{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wordflow.artifact_pin.v1",
  "title": "ArtifactPin",
  "description": "Immutable identity of an artifact (path, uri, or content hash).",
  "type": "object",
  "required": [
    "schema_version",
    "pin_id",
    "kind",
    "ref",
    "content_sha256",
    "pin_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "pin_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["file", "uri", "blob", "hf_repo", "git_ref", "other"]
    },
    "ref": { "type": "string", "minLength": 1 },
    "content_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "media_type": { "type": ["string", "null"] },
    "lock_id": { "type": ["string", "null"] },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pin_hash": { "type": "string" }
  }
}
