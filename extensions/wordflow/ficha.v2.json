{
  "schema_version": "2.0",
  "artifact_id": "wordflow.extension.core",
  "name": "wordflow",
  "version": "1.0.0",
  "abi_version": "2.0",
  "extension_type": "workflow",
  "kernel_min": "0.1.0",
  "mount_mode": "sidecar",
  "load_priority": 40,
  "llm_control": "DENY",
  "entrypoint": "engine.entrypoint:run_wordflow",
  "description": "Wordflow core — InputBlock → Goals → Refute/Repair → Sentinel → Council → main_12 + watchdog/supervisor",
  "depends_on": [
    "wordflow.extension.audit_forensic"
  ],
  "contrato": {
    "expone": [
      "run_wordflow",
      "run_main_12",
      "goals_out_to_evidence_packet",
      "check_watchdog",
      "make_checkpoint"
    ],
    "consume": [
      "EvidencePacket"
    ]
  },
  "ejecucion": {
    "transport": "stdio",
    "sandbox": "container",
    "parallel_max": 1
  },
  "perfiles": {
    "default": {
      "timeout_seconds": 120,
      "checkpoint_ttl": 3600,
      "fail_closed": true
    }
  },
  "seguridad": {
    "token_in_logs": false,
    "secret_scan": true,
    "fail_closed": true
  },
  "evidencia": {
    "levels": ["L1", "L2", "L3", "L4"],
    "packet_schema": "wordflow.audit.forensic.EvidencePacket.v1"
  },
  "policies": {
    "sheriff": "policies/sheriff.yaml",
    "sentinel": "policies/sentinel.yaml"
  },
  "schemas": {
    "input_block": "schemas/input_block.schema.json",
    "architecture_output": "schemas/architecture_output.schema.json",
    "code_output": "schemas/code_output.schema.json"
  }
}
