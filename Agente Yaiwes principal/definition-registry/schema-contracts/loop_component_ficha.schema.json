{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaiwes://schema/loop-component-provenance/v1",
  "title": "YAIWES Loop Component Provenance Descriptor",
  "description": "Provenance descriptor for PLAN30 components. ficha_path MUST point to the actual Ficha Contract v2 JSON; this schema does not replace Ficha Contract v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "contract", "capability", "source", "destination", "ficha_path",
    "inputs", "outputs", "fail_closed", "health", "evidence"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "contract": {"const": "tel.workflow/v3"},
    "capability": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "sha", "decision"],
      "properties": {
        "repo": {"type": "string"},
        "path": {"type": "string"},
        "sha": {"type": "string", "minLength": 7},
        "decision": {"enum": ["REUSE", "COPY", "PATCH", "ADAPTER", "COPY+ADAPTER"]}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha"],
      "properties": {
        "path": {"type": "string"},
        "sha": {"type": "string", "minLength": 7}
      }
    },
    "ficha_path": {"type": "string", "pattern": "^Agente Yaiwes principal/.+ficha\\..+\\.v2\\.json$"},
    "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "fail_closed": {"type": "boolean", "const": true},
    "health": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}