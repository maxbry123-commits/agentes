{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wordflow.scheduler_task.v1",
  "title": "SchedulerTask",
  "type": "object",
  "required": ["task_id", "priority", "depends_on", "status"],
  "properties": {
    "task_id": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "READY", "RUNNING", "DONE", "FAILED", "CANCELLED"]
    },
    "payload": { "type": "object", "additionalProperties": true }
  }
}
