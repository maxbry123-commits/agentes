{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C19_RUN_CODE_PATH_INPUT",
  "title": "C-19 run_code_path input contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "raw_input": {"type": "string"},
    "plan_steps": {"type": "array", "items": {"type": "string"}},
    "skill": {"type": ["object", "null"]},
    "mission_id": {"type": "string"},
    "context_verified": {"type": "boolean"},
    "handoff_verified": {"type": "boolean"},
    "core_measures": {"type": ["object", "null"], "additionalProperties": {"type": "boolean"}},
    "connectivity": {"type": ["object", "null"]},
    "counters": {"type": ["object", "null"]},
    "evidence_complete": {"type": "boolean"},
    "final_clean_reaudit_passed": {"type": "boolean"},
    "quality_dag_ok": {"type": "boolean"},
    "context_manifest": {},
    "require_context_manifest": {"type": "boolean"},
    "symbol_or_stem": {"type": "string"},
    "dest": {"type": "string"},
    "checklist": {},
    "require_pre_gate": {"type": ["boolean", "null"]},
    "require_checklist": {"type": "boolean"},
    "run_quality_dag": {"type": "boolean"},
    "fc_results": {"type": ["object", "null"], "additionalProperties": {"type": "boolean"}},
    "require_fc": {"type": "boolean"},
    "auto_measure_core": {"type": "boolean"},
    "auto_measure_fc": {"type": "boolean"},
    "apply_adapt": {"type": "boolean"},
    "import_mapping": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
    "profile": {"type": "string"},
    "scan_paths": {"type": ["array", "null"], "items": {"type": "string"}},
    "consult_gateway": {"type": "boolean"}
  },
  "required": ["raw_input"]
}
