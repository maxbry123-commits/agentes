# engine.py — motor determinista (PROBADO arriba). El modelo propone; esto decide.
from __future__ import annotations
import hashlib, json, os, time
from dataclasses import dataclass, field
from typing import Any

STAGES = ("SHERIFF","VALIDATOR","SIMULATE","RESEARCH","RANK","EXECUTE",
          "SENTINEL","VERIFY","SUPERVISOR","JUDGE","GUARDIAN","CODA")

def canonical(x: Any) -> str:
    return json.dumps(x, ensure_ascii=False, sort_keys=True, separators=(",", ":"))

def sha(x: Any) -> str:
    raw = x if isinstance(x, str) else canonical(x)
    return hashlib.sha256(raw.encode()).hexdigest()

def ledger_append(state: dict, event: dict) -> None:
    ledger = state.setdefault("ledger", [])
    prev = ledger[-1]["hash"] if ledger else "0"*64
    row = {"seq": len(ledger)+1, "prev_hash": prev, "event": event}
    row["hash"] = sha(row)
    ledger.append(row)

def ledger_verify(state: dict) -> bool:
    prev = "0"*64
    for seq, row in enumerate(state.get("ledger", []), 1):
        raw = {k: v for k, v in row.items() if k != "hash"}
        if row.get("seq") != seq or row.get("prev_hash") != prev: return False
        if row.get("hash") != sha(raw): return False
        prev = row["hash"]
    return True

@dataclass
class Node:
    id: str; type: str; literal: str
    depends_on: list = field(default_factory=list)
    preconditions: list = field(default_factory=list)
    postconditions: list = field(default_factory=list)
    authorization: list = field(default_factory=list)
    status: str = "PENDING"
    def export(self) -> dict:
        return {"id": self.id, "type": self.type, "literal": self.literal,
                "literal_sha256": sha(self.literal), "depends_on": self.depends_on,
                "preconditions": self.preconditions, "postconditions": self.postconditions,
                "authorization": self.authorization, "status": self.status}

class Coda:
    def __init__(self, rechecks: int = 10): self.rechecks = rechecks
    def validate(self, state: dict, submission: dict) -> list:
        gates = {
            "input_goals": submission.get("input_goals") == [True]*12,
            "output_goals": submission.get("output_goals") == [True]*12,
            "zero_gaps": not submission.get("gaps"),
            "trace": submission.get("trace_complete") is True,
            "evidence": submission.get("evidence_complete") is True,
            "ledger": ledger_verify(state),
            "contract": submission.get("contract_sha256") == state["contract_sha256"],
        }
        snap = sha({"contract": state["contract_sha256"], "verified": state.get("verified", {}), "gates": gates})
        return [{"pass": i, "digest": snap, "result": "PASS" if all(gates.values()) else "FAIL", "gates": gates}
                for i in range(1, self.rechecks+1)]

class Engine:
    def __init__(self, cfg: dict, state: dict): self.cfg, self.state = cfg, state
    def node(self) -> dict: return self.state["nodes"][self.state["node_index"]]
    def stage(self) -> str: return STAGES[self.state["stage_index"]]

    def gap(self, reasons: list, delta: dict) -> None:
        sig = sha({"stage": self.stage(), "reasons": reasons, "delta": delta})
        repeated = sig in self.state.setdefault("failed_deltas", [])
        self.state["failed_deltas"].append(sig)
        self.state["gaps"] = [{"stage": self.stage(), "reasons": reasons, "delta_sha256": sig, "repeated": repeated}]
        ledger_append(self.state, {"kind": "GAP", "node": self.node()["id"], "stage": self.stage(),
                                    "recurrence": self.state["recurrence"], "reasons": reasons})
        self.state["recurrence"] += 1
        if self.state["recurrence"] > 100:
            self.state["status"] = "BLOCKED_WITH_TRACE"; return
        self.state["stage_index"] = STAGES.index("RESEARCH")
        self.state["status"] = "RUNNING"

    def passed(self, submission: dict) -> None:
        node, stage = self.node(), self.stage()
        self.state.setdefault("verified", {}).setdefault(node["id"], {})[stage] = \
            {"submission_sha256": sha(submission), "recurrence": self.state["recurrence"]}
        ledger_append(self.state, {"kind": "PASS", "node": node["id"], "stage": stage, "submission_sha256": sha(submission)})
        self.state["gaps"] = []
        if stage != "CODA":
            self.state["stage_index"] += 1; return
        proofs = Coda(10).validate(self.state, submission)
        if any(p["result"] != "PASS" for p in proofs):
            self.gap(["CODA_FAIL"], submission); return
        self.state.setdefault("coda_proofs", []).extend(proofs)
        node["status"] = "PASS"
        self.state["node_index"] += 1; self.state["stage_index"] = 0; self.state["recurrence"] = 1
        self.state["status"] = "CLOSED" if self.state["node_index"] == len(self.state["nodes"]) else "RUNNING"

def compile_contract(raw: str, nodes: list) -> dict:
    state = {"schema": "tel.state/v3", "status": "RUNNING", "contract_literal": raw,
             "contract_sha256": sha(raw), "nodes": [n.export() for n in nodes],
             "node_index": 0, "stage_index": 0, "recurrence": 1,
             "verified": {}, "gaps": [], "ledger": [], "coda_proofs": []}
    ledger_append(state, {"kind": "COMPILE", "contract_sha256": state["contract_sha256"], "node_count": len(nodes)})
    state["checkpoint_sha256"] = sha({k: v for k, v in state.items() if k != "checkpoint_sha256"})
    return state

# -- verificacion final independiente: no lee state["verified"] ni "coda_proofs" --
def verify_final(state: dict, checks: dict) -> dict:
    if state.get("status") != "CLOSED":
        return {"verdict": "NOT_APPLICABLE", "reason": "el pipeline interno aun no marca CLOSED"}
    if not checks:
        return {"verdict": "INCONCLUSIVE", "reason": "no hay ningun check falsificable registrado"}
    receipts, all_pass = [], True
    for name, fn in checks.items():
        t0 = time.time()
        try: ok, err = bool(fn()), None
        except Exception as e: ok, err = False, repr(e)
        receipts.append({"check": name, "result": "PASS" if ok else "FAIL", "error": err,
                          "ran_at": t0, "duration_s": round(time.time()-t0, 4)})
        all_pass = all_pass and ok
    verdict = "VERIFIED_CLOSED" if all_pass else "CLOSED_UNVERIFIED"
    state["status"] = verdict
    state["final_verification"] = receipts
    ledger_append(state, {"kind": "FINAL_VERIFY", "verdict": verdict,
                           "checks": [r["check"] for r in receipts], "receipts_sha256": sha(receipts)})
    return {"verdict": verdict, "receipts": receipts}

